{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "DocVault default permissions",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-copy-file",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-exists",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "shell:default",
    "shell:allow-execute"
  ],
  "scope": {
    "fs": {
      "allow": ["$APP/*", "$DESKTOP/*", "$DOCUMENT/*", "$DOWNLOAD/*", "$HOME/*", "**"]
    }
  },
  "remote": {
    "urls": []
  },
  "platforms": ["linux", "macOS", "windows", "android", "iOS"]
}
